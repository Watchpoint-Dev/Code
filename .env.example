# Watchpoint — toutes les variables du depot, SANS valeur.
# Copier la section utile dans le bon fichier (jamais commite) :
#   frontend/.env.local      le site (lu par Next.js)
#   backend/.env             le moteur (etape 6 : chargement Postgres)
#   research/ebay/.env       les essais eBay
# En production, les variables du site vivent dans Vercel, pas dans un fichier.

# --- Base de donnees (backend ET frontend) -------------------------------
# dev : URL de la branche Neon `dev`. prod : uniquement dans Vercel.
DATABASE_URL=

# --- Frontend : authentification Clerk -----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Backend : collecte (optionnel) --------------------------------------
# Tranches d'annees pour les maisons a historique profond, ex. 2010-2019 ou 2015,2016
WP_ANTIQUORUM_ANNEES=
WP_CHRISTIES_ANNEES=
# Faire tourner le moteur sur une autre copie des donnees
WATCHPOINT_RACINE=

# --- Research : API eBay --------------------------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
