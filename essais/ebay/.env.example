# Cles du keyset eBay — a copier vers .env (jamais commite)
#
# Ou les trouver : https://developer.ebay.com/my/keys
# Un keyset = 3 valeurs. Il y en a deux jeux : Sandbox et Production.
# Le Dev ID n'est PAS utilise par la Browse API, inutile de le mettre ici.

# sandbox | production
EBAY_ENV=sandbox

# "App ID (Client ID)" sur la page keys
EBAY_APP_ID=

# "Cert ID (Client Secret)" sur la page keys — secret, ne jamais partager
EBAY_CERT_ID=

# Marche eBay interroge. EBAY_US par defaut.
# Autres valeurs utiles : EBAY_GB, EBAY_DE, EBAY_FR, EBAY_IT, EBAY_CH
EBAY_MARKETPLACE=EBAY_US
